using AudioSync.Api.Interfaces;
using Microsoft.AspNetCore.SignalR;

namespace AudioSync.Api.Hubs
{
    public class RoomHub : Hub
    {
        private readonly IRoomService _roomService;
        private readonly ILogger<RoomHub> _logger;

        public RoomHub(IRoomService roomService, ILogger<RoomHub> logger)
        {
            _roomService = roomService;
            _logger = logger;
        }

        public async Task JoinRoom(string roomCode)
        {
            var httpContext = Context.GetHttpContext();
            var userName = httpContext?.Request.Query["username"].FirstOrDefault() ?? "Anonymous";

            var added = await _roomService.AddParticipantAsync(roomCode, Context.ConnectionId, userName);
            if (!added)
            {
                _logger.LogWarning("JoinRoom failed - room not found: {RoomCode}", roomCode);
                // Optionally, you could throw a HubException to notify client
                throw new HubException("Room not found");
            }

            await Groups.AddToGroupAsync(Context.ConnectionId, roomCode);

            _logger.LogInformation("Connection {ConnectionId} joined room {RoomCode} as {UserName}", Context.ConnectionId, roomCode, userName);

            await Clients.Group(roomCode).SendAsync("UserJoined", new { ConnectionId = Context.ConnectionId, UserName = userName, JoinedAt = DateTime.UtcNow });
        }

        public async Task LeaveRoom(string roomCode)
        {
            var removed = await _roomService.RemoveParticipantAsync(roomCode, Context.ConnectionId);
            await Groups.RemoveFromGroupAsync(Context.ConnectionId, roomCode);

            if (removed)
            {
                _logger.LogInformation("Connection {ConnectionId} left room {RoomCode}", Context.ConnectionId, roomCode);
                await Clients.Group(roomCode).SendAsync("UserLeft", new { ConnectionId = Context.ConnectionId });
            }
            else
            {
                _logger.LogWarning("LeaveRoom: participant not found in room {RoomCode}: {ConnectionId}", roomCode, Context.ConnectionId);
            }
        }

        public async Task Play(string roomCode)
        {
            _logger.LogInformation("Play received from {ConnectionId} for room {RoomCode}", Context.ConnectionId, roomCode);
            await Clients.Group(roomCode).SendAsync("PlayReceived", new { ConnectionId = Context.ConnectionId, Timestamp = DateTime.UtcNow });
        }

        public async Task Pause(string roomCode)
        {
            _logger.LogInformation("Pause received from {ConnectionId} for room {RoomCode}", Context.ConnectionId, roomCode);
            await Clients.Group(roomCode).SendAsync("PauseReceived", new { ConnectionId = Context.ConnectionId, Timestamp = DateTime.UtcNow });
        }

        public async Task Seek(string roomCode, double position)
        {
            _logger.LogInformation("Seek received from {ConnectionId} for room {RoomCode} to position {Position}", Context.ConnectionId, roomCode, position);
            await Clients.Group(roomCode).SendAsync("SeekReceived", new { ConnectionId = Context.ConnectionId, Position = position, Timestamp = DateTime.UtcNow });
        }

        public override async Task OnDisconnectedAsync(Exception? exception)
        {
            // remove from all rooms and notify groups
            // first find rooms that contained this connection
            var connectionId = Context.ConnectionId;

            // We will remove the participant from all rooms; but we also need to notify each room's group
            // Since RoomService does not return the list of rooms removed, we'll enumerate rooms here via GetRoom for simplicity

            // Build a list of rooms that included this connection
            var roomsToNotify = new List<string>();

            // This is a mild violation of SRP but acceptable for MVP
            // Accessing internal store via GetRoom and checking participants
            // Note: GetRoom is thread-safe for reading

            // Get all rooms codes - RoomService does not expose them; to avoid changing the service further, we can attempt to remove from all rooms by calling RemoveParticipantFromAllRoomsAsync and then broadcasting UserLeft to all groups.

            await _roomService.RemoveParticipantFromAllRoomsAsync(connectionId);

            // We cannot know which rooms were affected here without additional API; to keep clients consistent, we will broadcast UserLeft to all groups known by the caller.
            // For correctness we will not broadcast here; instead, clients receive UserLeft when they explicitly LeaveRoom. Because OnDisconnectedAsync removal may have occurred, but we cannot reliably notify groups without additional data.

            _logger.LogInformation("Connection {ConnectionId} disconnected", connectionId);

            await base.OnDisconnectedAsync(exception);
        }
    }
}
