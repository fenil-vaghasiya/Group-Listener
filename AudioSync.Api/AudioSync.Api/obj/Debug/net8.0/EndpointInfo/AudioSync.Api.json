{
  "openapi": "3.0.1",
  "info": {
    "title": "AudioSync.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/rooms/create": {
      "post": {
        "tags": [
          "Room"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoomCreateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RoomCreateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RoomCreateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rooms/join": {
      "post": {
        "tags": [
          "Room"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoomJoinDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RoomJoinDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RoomJoinDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rooms/{roomCode}": {
      "get": {
        "tags": [
          "Room"
        ],
        "parameters": [
          {
            "name": "roomCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rooms/{roomCode}/media-state": {
      "get": {
        "tags": [
          "Room"
        ],
        "parameters": [
          {
            "name": "roomCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoomCreateDto": {
        "type": "object",
        "properties": {
          "hostName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RoomJoinDto": {
        "required": [
          "roomCode",
          "userName"
        ],
        "type": "object",
        "properties": {
          "roomCode": {
            "maxLength": 6,
            "minLength": 6,
            "type": "string"
          },
          "userName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}